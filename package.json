{
  "name": "astralis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Astralis — cartographie céleste, numérologie et Human Design. Application React/TypeScript.",
  "engines": {
    "node": "^20.19.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",

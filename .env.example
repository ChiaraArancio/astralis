# ---------------------------------------------------------------------------
# Astralis — variables d'environnement
# ---------------------------------------------------------------------------
# Copiez ce fichier en `.env.local` pour le développement local.
# Ne committez JAMAIS de clé secrète.
# Les variables sans préfixe VITE_ restent côté serveur (fonctions Vercel).
# Aucune variable VITE_ n'est nécessaire aujourd'hui : le site fonctionne
# sans compte externe ni clé API pour les calculateurs.
# ---------------------------------------------------------------------------

# --- Resend (newsletter, facultatif) ---------------------------------------
# Sans ces valeurs, le formulaire affiche un message explicite et n'enregistre
# rien. Le site reste entièrement utilisable.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM_EMAIL="Astralis <newsletter@votre-domaine.fr>"
CONTACT_TO_EMAIL=

# --- Stripe (paiements futurs, désactivés par défaut) ----------------------
# Ne passez à true qu'après avoir configuré Stripe et vérifié les obligations
# légales (TVA, rétractation, CGV). Aucun paiement n'est ouvert actuellement.
ENABLE_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
APP_URL=http://localhost:5173

# --- Hébergement (facultatif, Vercel le fournit) ---------------------------
# VERCEL_URL est injecté automatiquement par Vercel.
